# SewIt — переменные окружения (README 8.4).
# Скопируйте в .env.local и заполните. Реальные секреты в git не попадают.

# URL проекта Supabase (браузер и сервер)
NEXT_PUBLIC_SUPABASE_URL=
# Публичный anon-ключ, доступ ограничен RLS (браузер и сервер)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# !Только сервер: обход RLS для подписи URL и оформления заказов. Никогда не публиковать.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI для link/db push (локально и в CI, не в Vercel)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Канонический URL для OG, sitemap и редиректов после входа
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# TTL подписанной ссылки на PDF, секунды (FR-7.1)
DOWNLOAD_URL_TTL_SECONDS=600
